# Vorlage für die lokale .env — die .env selbst gehört NICHT ins Repo.
# Kopieren mit:  cp .env.example .env

# Signiert die JWTs. Mindestens 32 Zeichen, pro Umgebung ein eigener Wert.
# Erzeugen mit:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Gültigkeitsdauer der Tokens (ms-Format: 60s, 15m, 1h, 7d).
JWT_EXPIRES_IN=1h

# Port des Servers (Standard: 3000).
PORT=3000

# Erlaubte Frontend-Origins, kommagetrennt.
# Standard ohne Angabe: http://localhost:5173,http://localhost:4173
CORS_ORIGIN=http://localhost:5173


# --- Cloudflare R2 (S3-kompatibler Objektspeicher für die Audiodateien) ---
# Zugangsdaten: Dashboard → R2 → Manage R2 API Tokens → Account API Token
# mit Berechtigung "Object Read & Write", beschränkt auf das eigene Bucket.

# WICHTIG: ohne Bucket-Namen am Ende! Cloudflare zeigt auf der Bucket-Seite
# oft die volle URL inkl. Bucket an — die gehört hier NICHT hin, sonst baut
# das SDK Pfade wie /bucket/bucket/datei.wav und du bekommst 404.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Name des Buckets, wird bei jedem Aufruf separat mitgegeben.
R2_BUCKET=

# Access Key ID und Secret aus dem R2-Token. Das Secret wird beim Anlegen
# nur ein einziges Mal angezeigt.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=


# Maximale Uploadgröße in MB. Greift als hartes Limit in Multer.
# Nicht zu hoch setzen: die Datei liegt beim Upload komplett im RAM.
MAX_UPLOAD_MB=60
