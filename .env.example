# Vorlage für die lokale .env — die .env selbst gehört NICHT ins Repo.
# Kopieren mit:  cp .env.example .env

# Signiert die JWTs. Mindestens 32 Zeichen, pro Umgebung ein eigener Wert.
# Erzeugen mit:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Gültigkeitsdauer der Tokens (ms-Format: 60s, 15m, 1h, 7d).
JWT_EXPIRES_IN=1h

# Port des Servers (Standard: 3000).
PORT=3000

# Erlaubte Frontend-Origins, kommagetrennt.
# Standard ohne Angabe: http://localhost:5173,http://localhost:4173
CORS_ORIGIN=http://localhost:5173
